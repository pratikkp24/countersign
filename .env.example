# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox REST app: developer.paypal.com > Apps & Credentials > Sandbox > Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: the email of any sandbox account you have (developer.paypal.com > Sandbox accounts), personal or business.
# The first supplier is paid there, so its payout completes (SUCCESS) instead of UNCLAIMED.
DEMO_PAYEE_EMAIL=

# The model that reads the invoices. Groq (default: openai/gpt-oss-120b) or Claude.
# With neither key, the app uses a replay model (recorded answers for the five demo invoices).
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# COUNTERSIGN_MODEL=groq:openai/gpt-oss-120b   # or claude-sonnet-5-5, claude-opus-5-5, replay
